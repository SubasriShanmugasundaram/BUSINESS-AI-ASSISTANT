# ==========================================================
# BizPartner AI - Environment Configuration Example
# Copy this file to .env and configure local secrets
# ==========================================================

# Google Gemini API Key for AI Assistant (Never commit real API keys)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (HMAC-SHA256 compatible, 256-bit+)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Active Spring Profile: 'dev' for in-memory H2, 'prod' for MySQL
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Used when profile is 'prod')
DB_URL=jdbc:mysql://localhost:3306/business_assistant_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Python FastAPI ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# Backend Server Port
PORT=8080
